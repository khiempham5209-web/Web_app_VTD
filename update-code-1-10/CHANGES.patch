+  const values = sh.getRange(2, maDonCol, lastRow - 1, 1).getDisplayValues();
+  for (let i = 0; i < values.length; i++) {
+    if (rejectSyncNorm_(values[i][0]) === q) return i + 2;
+  }
+  return 0;
