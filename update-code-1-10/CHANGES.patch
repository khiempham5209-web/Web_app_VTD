+  if (lastRow < 2) return 0;
+  const col = rejectSyncHeaderMap_(rejectSyncHeaders_(sh));
+  const maDonCol = rejectSyncFirstCol_(col, ["ma don ghtk", "ma don"]);
+  if (!maDonCol) return 0;
