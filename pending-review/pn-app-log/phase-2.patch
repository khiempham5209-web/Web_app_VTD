+// Enable only with an authenticated PN deployment. The existing PN doPost does not verify VTD tokens.
+function pnAppLogReceive_(params) {
+  const events = Array.isArray(params.events) ? params.events.slice(0, 20) : [];
+  const ack = [], groups = new Map();
+  const states = {
+    SAVE_CLICKED: [1, 'PROCESSING'], APP_QUEUED: [2, 'QUEUED'],
+    APP_REJECTED: [2, 'REJECTED'], SEND_STARTED: [3, 'SENDING'],
+    SEND_PREP_FAILED: [3, 'FAILED'], APP_RETRY: [0, 'RETRY_PENDING'],
+    APP_ACK: [9, ''], RESPONSE_TIMEOUT: [9, ''], RESPONSE_LOST: [9, '']
+  };
+  const receivedAt = new Date().toISOString();
+  for (const event of events) {
+    if (!event || !/^LOCAL-\d{13}-[a-f0-9]{1,32}$/.test(event.eventId)) continue;
+    const key = pnAppLogOrderKey_(event.maDonGhtk), timestamp = Date.parse(event.at);
+    if (!key || !Object.prototype.hasOwnProperty.call(states, event.state) ||
+        !/^LOCAL-\d{13}-[a-f0-9]{1,32}$/.test(event.clientId) || !Number.isFinite(timestamp)) {
+      ack.push(event.eventId);
+      continue;
+    }
+    const id = key + ':' + event.clientId;
+    if (!groups.has(id)) groups.set(id, {key, input: {}, app: true, operationId: event.clientId,
+      orderNo: pnAppLogCode_(event.orderNo), source: pnAppLogCode_(event.returnType),
+      user: pnAppLogCode_(params.userEmail), startedAt: receivedAt, events: []});
+    const [update, status] = states[event.state];
+    groups.get(id).events.push({
+      eventId: event.eventId, state: event.state, at: new Date(timestamp).toISOString(),
+      receivedAt, origin: 'APP', update, status, code: /^[A-Z0-9_]{1,50}$/.test(event.code) ? event.code : ''
+    });
+  }
+  for (const group of groups.values()) {
+    pnAppLogContext_ = group;
+    try {
+      if (pnAppLogFlush_()) group.events.forEach(event => ack.push(event.eventId));
+    } finally {
+      pnAppLogContext_ = null;
+    }
+  }
+  return {ok: true, ack};
+}
+
+function pnAppLogAuthorizedReceive_(params) {
+  const url = PropertiesService.getScriptProperties().getProperty('PN_LOG_VTD_API_URL') || '';
+  if (!/^https:\/\/script\.google\.com\/macros\/s\/[\w-]+\/exec$/.test(url)) {
+    return {ok: false, code: 'PN_LOG_AUTH_NOT_CONFIGURED'};
+  }
+  const token = String(params.sessionToken || '');
+  if (!/^[\w-]{20,180}$/.test(token)) return {ok: false, code: 'UNAUTHORIZED'};
+  const response = UrlFetchApp.fetch(url, {
+    method: 'post', contentType: 'application/json', muteHttpExceptions: true,
+    payload: JSON.stringify({action: 'pnLogSession', params: {sessionToken: token}})
+  });
+  const identity = JSON.parse(response.getContentText());
+  if (!identity.ok || !identity.email) return {ok: false, code: 'UNAUTHORIZED'};
+  return pnAppLogReceive_(Object.assign({}, params, {userEmail: identity.email}));
+}
